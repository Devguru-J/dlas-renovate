{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dlas",
  // 이 계정에 로그인된 계정이 둘이라, 없으면 wrangler 명령마다
  // "More than one account available"로 멈춘다(비대화형에서는 아예 실패한다).
  // 계정 ID는 비밀값이 아니다.
  "account_id": "08a401b4406beae7e53b9a14d0d01d61",
  // 어댑터 기본 엔트리(@astrojs/cloudflare/entrypoints/server) 대신 우리 파일을 쓴다.
  // Cron 트리거는 scheduled 핸들러를 export하는 엔트리를 요구하는데 어댑터 엔트리는
  // fetch만 내보내기 때문이다. src/worker.ts는 그 fetch를 그대로 재수출하고
  // scheduled만 얹는다.
  "main": "src/worker.ts",
  // 설치된 workerd 바이너리가 지원하는 최신 날짜. 이보다 미래로 두면 빌드가 실패한다.
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  // CRM 재시도 크론. 10분마다 깨어나지만 실제 재시도 간격은 DB 조건
  // (CRM_RETRY_SPACING_MS = 30분)이 지키므로, 크론 주기를 줄여도 재시도 예산은 줄지 않는다.
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  // 컨택폼 엔드포인트의 속도 제한. Cloudflare가 엣지에서 카운터를 들고 있으므로
  // Supabase에 닿기 전에 요청을 흘려버릴 수 있다 — 즉 이 검사 자체는 공격에 쓰일 수 없다.
  //
  // simple.limit은 period 동안 허용되는 요청 수다. period는 10 또는 60만 허용된다.
  // - RL_PER_IP: 한 IP가 1분에 8건. 사람이 폼을 채워 보내는 속도로는 절대 닿지 않고,
  //   "따라라락" 연타·스크립트 투하는 즉시 걸린다.
  // - RL_GLOBAL: 모든 IP 합산 1분에 600건. 이 값은 "재난 백스톱"이지 스팸 방어가 아니다.
  //   전역 리밋이 걸리면 정상 고객까지 전부 막히므로, 임계값을 낮게 잡으면 공격자에게
  //   폼 전체를 끄는 스위치를 쥐여주는 셈이 된다. 초기값 60건/분(=초당 1건)은
  //   노트북 한 대로도 유지할 수 있는 수준이었다(실측 68.7 req/s). 스팸은 Turnstile과
  //   IP 리밋이 싸게 쳐내고, 이 계층은 워커가 녹는 것만 막는다.
  // - RL_ALERT: 리밋이 아니라 알림 도배 방지용 문이다. 1분에 한 번만 통과시킨다.
  //   전역 리밋이 걸렸다는 건 폼이 모두에게 죽었다는 뜻이라 반드시 사람이 알아야 하는데,
  //   공격 중에는 그 조건이 초당 수십 번 성립하기 때문이다.
  "unsafe": {
    "bindings": [
      {
        "name": "RL_PER_IP",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 8, "period": 60 }
      },
      {
        "name": "RL_GLOBAL",
        "type": "ratelimit",
        "namespace_id": "1002",
        "simple": { "limit": 600, "period": 60 }
      },
      {
        "name": "RL_ALERT",
        "type": "ratelimit",
        "namespace_id": "1003",
        "simple": { "limit": 1, "period": 60 }
      }
    ]
  },
  "r2_buckets": [
    {
      // about 페이지 영상. 정적 자산은 Range 요청에 206을 주지 않아 워커가 직접 서빙한다.
      "binding": "MEDIA",
      "bucket_name": "dlas-media"
    },
    {
      "binding": "FORM_UPLOADS",
      "bucket_name": "dlas-form-uploads",
      "preview_bucket_name": "dlas-form-uploads-preview"
    }
  ]
}
